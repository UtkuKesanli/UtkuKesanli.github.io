---
import type { SkillGroup } from '../data/skills';

type Props = {
  group: SkillGroup;
};

const { group } = Astro.props;
---

<article class="skill-card">
  <div class="card-head">
    <span class="index">{group.index}</span>
    <h3>{group.title}</h3>
  </div>

  <div class="skill-list">
    {group.skills.map((skill) => <span class="skill-chip">{skill}</span>)}
  </div>
</article>

<style>
  .skill-card {
    min-height: 245px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: clamp(1.3rem, 2.5vw, 1.8rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: linear-gradient(145deg, rgba(255,255,255,0.022), rgba(255,255,255,0.006));
    transition: transform 220ms ease, border-color 220ms ease, background 220ms ease;
  }

  .skill-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-soft-strong);
    background: linear-gradient(145deg, var(--accent-soft), rgba(255,255,255,0.01));
  }

  .card-head {
    display: grid;
    gap: 0.8rem;
  }

  .index {
    color: var(--accent);
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  h3 {
    margin: 0;
    max-width: 290px;
    font-size: clamp(1.45rem, 2.5vw, 2rem);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-chip {
    padding: 0.48rem 0.68rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.74rem;
    line-height: 1;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .skill-card:hover .skill-chip {
    border-color: rgba(143, 124, 255, 0.2);
  }

  .skill-chip:hover {
    color: var(--text);
    border-color: var(--accent) !important;
    background: var(--accent-soft);
  }
</style>
