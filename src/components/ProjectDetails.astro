---
import type { ProjectDetail } from '../data/projects';
type Props = { title: string; details: ProjectDetail[]; highlights: string[] };
const { title, details, highlights } = Astro.props;
---
<details class="project-details">
  <summary>Read {title} case study <span aria-hidden="true">＋</span></summary>
  <div class="details-grid">
    <section>
      <h4>My contribution</h4>
      <ul>{highlights.map(highlight => <li>{highlight}</li>)}</ul>
    </section>
    {details.map(detail => <section><h4>{detail.title}</h4><p>{detail.text}</p></section>)}
  </div>
</details>
<style>
  .project-details { border: 1px solid var(--line-strong); border-radius: var(--radius-md); background: rgba(255,255,255,.012); }
  summary { min-height: 48px; padding: .85rem 1rem; cursor: pointer; font-size: .9rem; font-weight: 650; }
  summary span { float: right; }
  details[open] summary span { transform: rotate(45deg); }
  .details-grid { display: grid; gap: 1.25rem; padding: 1.25rem; border-top: 1px solid var(--line); }
  h4 { margin: 0 0 .5rem; font-size: 1rem; color: var(--text); }
  p, ul { margin: 0; font-size: .95rem; line-height: 1.7; color: var(--text-muted); }
  ul { padding-left: 1.2rem; }
</style>
