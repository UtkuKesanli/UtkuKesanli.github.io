---
import { socialLinks } from '../data/socialLinks';

const sectionLinks = [
  { label: 'About', href: '#about', id: 'about' },
  { label: 'Projects', href: '#projects', id: 'projects' },
  { label: 'Experience', href: '#experience', id: 'experience' },
  { label: 'Skills', href: '#skills', id: 'skills' },
  { label: 'Contact', href: '#contact', id: 'contact' },
];
---

<header class="top-links" aria-label="Portfolio navigation">
  <nav>
    <a class="home-link" href="#home" aria-label="Back to top">UK</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="portfolio-menu" hidden>Menu <span aria-hidden="true">☰</span></button>
    <div class="nav-scroll" id="portfolio-menu">
      <div class="section-links" aria-label="Page sections">
        {sectionLinks.map((link) => (
          <a href={link.href} data-section-link={link.id}>{link.label}</a>
        ))}
      </div>

      <span class="divider" aria-hidden="true"></span>

      <div class="social-links" aria-label="External links">
        {socialLinks.map((link) => (
          <a
            href={link.href}
            target={link.href.startsWith('http') ? '_blank' : undefined}
            rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
            aria-label={link.label}
          >
            <span class="social-full">{link.label}</span>
            <span class="social-short">{link.shortLabel}</span>
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  const initialiseSectionNavigation = () => {
    const header = document.querySelector<HTMLElement>('.top-links');
    const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
    if (!header || !toggle || header.dataset.ready) return;
    header.dataset.ready = 'true';
    toggle.hidden = false;
    const close = () => toggle.setAttribute('aria-expanded', 'false');
    toggle.addEventListener('click', () => toggle.setAttribute('aria-expanded', String(toggle.getAttribute('aria-expanded') !== 'true')));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') { close(); toggle.focus(); }
    });
    header.querySelectorAll('a').forEach(link => link.addEventListener('click', close));
    document.addEventListener('click', event => { if (event.target instanceof Node && !header.contains(event.target)) close(); });

    const links = Array.from(document.querySelectorAll<HTMLElement>('[data-section-link]'));
    if (!links.length) return;

    const byId = new Map(links.map((link) => [link.dataset.sectionLink, link]));
    const sections = Array.from(byId.keys())
      .map((id) => (id ? document.getElementById(id) : null))
      .filter((section): section is HTMLElement => section instanceof HTMLElement);

    const setActive = (id?: string) => {
      links.forEach((link) => {
        const active = Boolean(id) && link.dataset.sectionLink === id;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    let frame = 0;
    const updateActive = () => {
      frame = 0;
      const probe = window.scrollY + Math.min(window.innerHeight * 0.3, 220);
      const current = sections.filter((section) => section.getBoundingClientRect().top + window.scrollY <= probe).at(-1);
      setActive(current?.id); // The hero precedes every named section, so none is active there.
    };
    const scheduleUpdate = () => {
      if (!frame) frame = window.requestAnimationFrame(updateActive);
    };
    window.addEventListener('scroll', scheduleUpdate, { passive: true });
    window.addEventListener('resize', scheduleUpdate);
    updateActive();
  };

  initialiseSectionNavigation();
  document.addEventListener('astro:page-load', initialiseSectionNavigation);
</script>

<style>
  .top-links {
    position: fixed;
    top: 0.8rem;
    left: 50%;
    z-index: 50;
    width: min(calc(100% - 2rem), var(--max-width));
    transform: translateX(-50%);
  }

  nav {
    min-height: var(--topbar-height);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: rgba(10, 10, 10, 0.9);
    backdrop-filter: blur(10px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.2);
  }

  .home-link {
    flex: 0 0 auto;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--accent);
    font-size: 0.8rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    transition: border-color 160ms ease, background 160ms ease;
  }

  .home-link:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .nav-scroll {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .section-links,
  .social-links {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.1rem;
  }

  .section-links a,
  .social-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0.45rem 0.7rem;
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.8rem;
    transition: color 160ms ease, background 160ms ease;
  }

  .section-links a:hover,
  .social-links a:hover,
  .section-links a.is-active {
    color: var(--text);
    background: var(--surface-soft);
  }

  .section-links a.is-active {
    box-shadow: inset 0 0 0 1px rgba(143, 124, 255, 0.22);
  }

  .section-links a.is-active::before {
    content: '';
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }

  .divider {
    flex: 0 0 auto;
    width: 1px;
    height: 20px;
    margin: 0 0.25rem;
    background: var(--line-strong);
  }

  .social-links {
    margin-left: auto;
  }

  .arrow {
    color: var(--accent);
    font-size: 0.8rem;
  }

  .social-short {
    display: none;
  }

  @media (max-width: 940px) {
    .social-full {
      display: none;
    }

    .social-short {
      display: inline;
    }
  }

  @media (max-width: 640px) {
    .top-links {
      top: 0.5rem;
      width: calc(100% - 1rem);
    }

    nav {
      gap: 0.3rem;
      padding: 0.35rem 0.4rem;
    }

    .home-link {
      width: 44px;
      height: 44px;
    }

    .section-links a,
    .social-links a {
      min-height: 44px;
      padding: 0.4rem 0.62rem;
      font-size: 0.8rem;
    }
  }

  .menu-toggle { display: none; }
  @media (max-width: 1100px) {
    nav { flex-wrap: wrap; border-radius: 24px; }
    .menu-toggle:not([hidden]) { display: flex; align-items: center; gap: .75rem; margin-left: auto; min-height: 44px; padding: .6rem 1rem; border: 1px solid var(--line-strong); border-radius: 20px; background: var(--surface); color: var(--text); font: inherit; cursor: pointer; }
    .nav-scroll { flex-basis: 100%; flex-direction: column; align-items: stretch; overflow: auto; max-height: calc(100dvh - 110px); padding: .5rem; }
    .top-links[data-ready] .menu-toggle[aria-expanded="false"] + .nav-scroll { display: none; }
    .section-links, .social-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin: 0; gap: .25rem; }
    .section-links a, .social-links a { min-width: 0; font-size: .875rem; min-height: 44px; }
    .social-full { display: inline; }
    .social-short { display: none; }
    .divider { width: 100%; height: 1px; margin: .5rem 0; }
  }
</style>
