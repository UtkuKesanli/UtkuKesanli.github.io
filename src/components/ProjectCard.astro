---
import type { Project } from '../data/projects';

type Props = {
  project: Project;
  index: number;
};

const { project, index } = Astro.props;
const displayIndex = String(index + 1).padStart(2, '0');
const external = project.href?.startsWith('http');
const images = project.images ?? [];
const hasCarousel = images.length > 0;
---

<article class="project-card" data-project={project.slug}>
  <div class="media-column">
    <div class="media-topline">
      <span class="project-index">{displayIndex}</span>

      {project.icon ? (
        <div class="project-icon">
          <img src={project.icon} alt={`${project.title} app icon`} loading="lazy" />
        </div>
      ) : (
        <div class="project-icon project-icon--fallback" aria-hidden="true">
          {project.title.slice(0, 2).toUpperCase()}
        </div>
      )}
    </div>

    {hasCarousel ? (
      <div class="project-carousel" data-project-carousel data-autoplay="true">
        <div class="image-stack" aria-label={`${project.title} application screenshots`}>
          {images.map((image, imageIndex) => (
            <figure
              class:list={['project-slide', { 'is-active': imageIndex === 0, 'is-next': imageIndex === 1 }]}
              data-slide-index={imageIndex}
            >
              <img
                src={image}
                alt={`${project.title} application screen ${imageIndex + 1}`}
                loading="lazy"
                decoding="async"
              />
            </figure>
          ))}
        </div>

        {images.length > 1 && (
          <>
            <button class="carousel-button carousel-button--previous" type="button" data-carousel-previous aria-label={`Previous ${project.title} image`}>
              ←
            </button>
            <button class="carousel-button carousel-button--next" type="button" data-carousel-next aria-label={`Next ${project.title} image`}>
              →
            </button>

            <div class="carousel-dots" aria-hidden="true">
              {images.map((_, imageIndex) => (
                <span class:list={['carousel-dot', { 'is-active': imageIndex === 0 }]} data-dot-index={imageIndex}></span>
              ))}
            </div>
          </>
        )}
      </div>
    ) : (
      <div class="development-visual" aria-label={`${project.title} is currently in development`}>
        <div class="development-orbit development-orbit--outer"></div>
        <div class="development-orbit development-orbit--inner"></div>
        <div class="development-core">
          <span>IN</span>
          <strong>DEVELOPMENT</strong>
        </div>
      </div>
    )}
  </div>

  <div class="information-column">
    <header class="project-heading">
      <div class="project-heading-copy">
        <div class="project-kicker">
          <span>{project.year}</span>
          <span class:list={['project-status', { developing: project.status === 'In development' }]}>
            {project.status}
          </span>
        </div>
        <h3>{project.title}</h3>
        <p>{project.subtitle}</p>
      </div>

      {project.href && (
        <a
          class="project-link"
          href={project.href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noreferrer' : undefined}
        >
          <span>{project.linkLabel ?? 'View project'}</span>
          <span aria-hidden="true">↗</span>
        </a>
      )}
    </header>

    <div class="description-box">
      <p class="project-description">{project.shortDescription}</p>

      <ul class="project-highlights">
        {project.highlights.map((highlight) => <li>{highlight}</li>)}
      </ul>

      <div class="project-tech" aria-label={`${project.title} technologies`}>
        {project.technologies.map((technology) => <span>{technology}</span>)}
      </div>
    </div>
  </div>
</article>

<script>
  const initialiseProjectCarousels = () => {
    document.querySelectorAll<HTMLElement>('[data-project-carousel]').forEach((carousel) => {
      if (carousel.dataset.initialised === 'true') return;
      carousel.dataset.initialised = 'true';

      const slides = Array.from(carousel.querySelectorAll<HTMLElement>('[data-slide-index]'));
      const dots = Array.from(carousel.querySelectorAll<HTMLElement>('[data-dot-index]'));
      const previousButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-previous]');
      const nextButton = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');

      if (slides.length < 2) return;

      let activeIndex = 0;
      let timer: number | undefined;
      let paused = false;

      const render = () => {
        slides.forEach((slide, slideIndex) => {
          slide.classList.remove('is-active', 'is-previous', 'is-next');

          if (slideIndex === activeIndex) {
            slide.classList.add('is-active');
            return;
          }

          if (slides.length === 2) {
            slide.classList.add('is-next');
            return;
          }

          const previousIndex = (activeIndex - 1 + slides.length) % slides.length;
          const nextIndex = (activeIndex + 1) % slides.length;

          if (slideIndex === previousIndex) slide.classList.add('is-previous');
          if (slideIndex === nextIndex) slide.classList.add('is-next');
        });

        dots.forEach((dot, dotIndex) => {
          dot.classList.toggle('is-active', dotIndex === activeIndex);
        });
      };

      const move = (direction: number) => {
        activeIndex = (activeIndex + direction + slides.length) % slides.length;
        render();
      };

      const stop = () => {
        if (timer !== undefined) window.clearInterval(timer);
        timer = undefined;
      };

      const start = () => {
        stop();
        if (paused || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        timer = window.setInterval(() => move(1), 3800);
      };

      carousel.addEventListener('mouseenter', () => {
        paused = true;
        stop();
      });

      carousel.addEventListener('mouseleave', () => {
        paused = false;
        start();
      });

      carousel.addEventListener('focusin', () => {
        paused = true;
        stop();
      });

      carousel.addEventListener('focusout', () => {
        paused = false;
        start();
      });

      previousButton?.addEventListener('click', () => move(-1));
      nextButton?.addEventListener('click', () => move(1));

      render();
      start();
    });
  };

  initialiseProjectCarousels();
  document.addEventListener('astro:page-load', initialiseProjectCarousels);
</script>

<style>
  .project-card {
    --project-accent: var(--accent);
    --project-accent-soft: var(--accent-soft);
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.45fr);
    gap: clamp(2rem, 5vw, 5rem);
    min-height: 610px;
    padding: clamp(1.5rem, 3vw, 3rem);
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 15% 50%, var(--project-accent-soft), transparent 36%),
      linear-gradient(145deg, rgba(255,255,255,0.025), rgba(255,255,255,0.008));
  }

  .project-card[data-project='talevd'] {
    --project-accent: #7f73ff;
    --project-accent-soft: rgba(95, 122, 255, 0.16);
  }

  .project-card[data-project='focial'] {
    --project-accent: #ff4c45;
    --project-accent-soft: rgba(255, 76, 69, 0.13);
  }

  .project-card[data-project='evender'] {
    --project-accent: #59d7be;
    --project-accent-soft: rgba(89, 215, 190, 0.12);
  }

  .media-column {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-right: clamp(1.5rem, 3vw, 2.5rem);
    border-right: 1px solid var(--line);
  }

  .media-topline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-height: 92px;
  }

  .project-index {
    color: var(--project-accent);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
  }

  .project-icon {
    display: grid;
    place-items: center;
    width: 74px;
    height: 74px;
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: #111;
    box-shadow: 0 16px 45px rgba(0, 0, 0, 0.2);
  }

  .project-icon img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-icon--fallback {
    color: var(--project-accent);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    background: var(--project-accent-soft);
  }

  .project-carousel {
    position: relative;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 450px;
    outline: none;
  }

  .image-stack {
    position: relative;
    width: min(72%, 235px);
    aspect-ratio: 0.49;
  }

  .project-slide {
    position: absolute;
    inset: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 24px;
    background: #111;
    opacity: 0;
    transform: translate3d(0, 0, 0) scale(0.88);
    transition:
      transform 650ms var(--ease-out),
      opacity 450ms ease,
      filter 450ms ease,
      box-shadow 450ms ease;
    pointer-events: none;
  }

  .project-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .project-slide.is-active {
    z-index: 3;
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: saturate(1);
    box-shadow: 0 30px 80px rgba(0,0,0,0.4), 0 0 42px var(--project-accent-soft);
  }

  .project-slide.is-previous {
    z-index: 1;
    opacity: 0.42;
    transform: translate3d(-24%, 6%, 0) rotate(-5deg) scale(0.9);
    filter: saturate(0.65) brightness(0.72);
  }

  .project-slide.is-next {
    z-index: 2;
    opacity: 0.52;
    transform: translate3d(24%, 3%, 0) rotate(5deg) scale(0.92);
    filter: saturate(0.72) brightness(0.8);
  }

  .carousel-button {
    position: absolute;
    top: 50%;
    z-index: 5;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: rgba(10,10,10,0.86);
    color: var(--text);
    font: inherit;
    opacity: 0;
    transform: translateY(-50%) scale(0.9);
    transition: opacity 180ms ease, transform 180ms ease, border-color 180ms ease;
    cursor: pointer;
  }

  .carousel-button:hover,
  .carousel-button:focus-visible {
    border-color: var(--project-accent);
    color: var(--project-accent);
  }

  .carousel-button--previous { left: 0; }
  .carousel-button--next { right: 0; }

  .project-carousel:hover .carousel-button,
  .project-carousel:focus-within .carousel-button {
    opacity: 1;
    transform: translateY(-50%) scale(1);
  }

  .carousel-dots {
    position: absolute;
    bottom: 0.2rem;
    display: flex;
    gap: 0.45rem;
  }

  .carousel-dot {
    width: 5px;
    height: 5px;
    border-radius: 999px;
    background: var(--text-muted);
    opacity: 0.45;
    transition: width 250ms ease, opacity 250ms ease, background 250ms ease;
  }

  .carousel-dot.is-active {
    width: 22px;
    background: var(--project-accent);
    opacity: 1;
  }

  .development-visual {
    position: relative;
    display: grid;
    place-items: center;
    flex: 1;
    min-height: 420px;
    isolation: isolate;
  }

  .development-visual::before {
    content: '';
    position: absolute;
    width: 210px;
    height: 210px;
    border-radius: 50%;
    background: var(--project-accent-soft);
    filter: blur(24px);
  }

  .development-orbit {
    position: absolute;
    border: 1px solid color-mix(in srgb, var(--project-accent) 45%, transparent);
    border-radius: 50%;
    animation: orbit 14s linear infinite;
  }

  .development-orbit::after {
    content: '';
    position: absolute;
    top: 50%;
    left: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--project-accent);
    box-shadow: 0 0 16px var(--project-accent);
  }

  .development-orbit--outer { width: 250px; height: 250px; }
  .development-orbit--inner { width: 176px; height: 176px; animation-direction: reverse; animation-duration: 10s; }

  .development-core {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.35rem;
    text-align: center;
  }

  .development-core span {
    color: var(--project-accent);
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.04em;
  }

  .development-core strong {
    color: var(--text-muted);
    font-size: 0.62rem;
    letter-spacing: 0.18em;
  }

  .information-column {
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(2rem, 4vw, 3rem);
    min-width: 0;
  }

  .project-heading {
    display: grid;
    gap: 1.2rem;
    text-align: center;
  }

  .project-heading-copy {
    display: grid;
    justify-items: center;
  }

  .project-kicker {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-status {
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .project-status.developing {
    border-color: color-mix(in srgb, var(--project-accent) 55%, transparent);
    color: var(--project-accent);
    background: var(--project-accent-soft);
  }

  h3 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 5rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .project-heading-copy > p {
    margin: 0.8rem 0 0;
    max-width: 620px;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 0.78rem;
    transition: color 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .project-link:hover {
    color: var(--text);
    border-color: var(--project-accent);
    background: var(--project-accent-soft);
  }

  .description-box {
    align-self: start;
    display: grid;
    gap: 1.6rem;
    padding: clamp(1.5rem, 3vw, 2.4rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.016);
  }

  .project-description {
    margin: 0;
    color: var(--text-muted);
    font-size: clamp(0.96rem, 1.4vw, 1.08rem);
    line-height: 1.72;
  }

  .project-highlights {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-highlights li {
    position: relative;
    padding-left: 1.15rem;
    color: var(--text);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .project-highlights li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.64em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--project-accent);
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .project-tech span {
    padding: 0.42rem 0.62rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.68rem;
  }

  @keyframes orbit {
    to { transform: rotate(360deg); }
  }

  @media (max-width: 900px) {
    .project-card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .media-column {
      min-height: 540px;
      padding-right: 0;
      padding-bottom: 2rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }

    .image-stack {
      width: min(56%, 230px);
    }
  }

  @media (max-width: 560px) {
    .project-card {
      padding: 1.15rem;
    }

    .media-column {
      min-height: 470px;
    }

    .project-icon {
      width: 62px;
      height: 62px;
      border-radius: 15px;
    }

    .project-carousel {
      min-height: 370px;
    }

    .image-stack {
      width: min(62%, 190px);
    }

    .carousel-button {
      opacity: 1;
      width: 38px;
      height: 38px;
      transform: translateY(-50%) scale(1);
    }

    .description-box {
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .development-orbit {
      animation: none;
    }
  }
</style>
