---
import type { Project } from '../data/projects';

type Props = {
  project: Project;
  index: number;
};

const { project, index } = Astro.props;
const displayIndex = String(index + 1).padStart(2, '0');
const external = project.href?.startsWith('http');
---

<article class="project-card">
  <div class="project-meta">
    <span class="project-index">{displayIndex}</span>
    <span class:list={['project-status', { developing: project.status === 'In development' }]}>
      {project.status}
    </span>
  </div>

  <div class="project-body">
    <div class="project-heading">
      <div>
        <p class="project-year">{project.year}</p>
        <h3>{project.title}</h3>
      </div>
      {project.href && (
        <a
          class="project-link"
          href={project.href}
          target={external ? '_blank' : undefined}
          rel={external ? 'noreferrer' : undefined}
          aria-label={`Open ${project.title}`}
        >
          ↗
        </a>
      )}
    </div>

    <p class="project-description">{project.shortDescription}</p>

    <div class="project-tech" aria-label={`${project.title} technologies`}>
      {project.technologies.map((technology) => <span>{technology}</span>)}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: grid;
    grid-template-columns: 128px minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 3rem);
    min-height: 320px;
    padding: clamp(1.4rem, 3vw, 2.4rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(circle at 90% 10%, var(--accent-soft), transparent 34%),
      linear-gradient(145deg, rgba(255,255,255,0.028), rgba(255,255,255,0.008));
    transition: transform 220ms ease, border-color 220ms ease;
  }

  .project-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-soft-strong);
  }

  .project-meta {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding-right: 1rem;
    border-right: 1px solid var(--line);
  }

  .project-index {
    color: var(--accent);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
  }

  .project-status {
    width: max-content;
    max-width: 100%;
    padding: 0.46rem 0.68rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .project-status.developing {
    border-color: var(--accent-soft-strong);
    color: var(--accent);
    background: var(--accent-soft);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
  }

  .project-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-year {
    margin: 0 0 0.5rem;
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-size: clamp(2.3rem, 5vw, 4.5rem);
    line-height: 0.95;
    letter-spacing: -0.055em;
  }

  .project-link {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    font-size: 1.1rem;
    transition: transform 180ms ease, background 180ms ease, border-color 180ms ease;
  }

  .project-link:hover {
    transform: translate(2px, -2px);
    background: var(--accent);
    border-color: var(--accent);
    color: #0a0a0a;
  }

  .project-description {
    margin: 0;
    max-width: 820px;
    color: var(--text-muted);
    font-size: clamp(1rem, 1.6vw, 1.18rem);
    line-height: 1.65;
  }

  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .project-tech span {
    padding: 0.45rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-muted);
    font-size: 0.72rem;
  }

  @media (max-width: 760px) {
    .project-card {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .project-meta {
      flex-direction: row;
      align-items: center;
      padding-right: 0;
      padding-bottom: 1rem;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
