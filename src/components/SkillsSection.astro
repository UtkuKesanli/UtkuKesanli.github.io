---
import SectionHeading from './SectionHeading.astro';
import SkillCard from './SkillCard.astro';
import { skillGroups } from '../data/skills';
---

<section class="portfolio-section" id="skills" aria-labelledby="skills-title">
  <SectionHeading
    index="05"
    title="Skills"
    description="A practical stack shaped around shipping mobile products from interface design to cloud-backed release."
  />

  <div class="skills-grid">
    {skillGroups.map((group) => <SkillCard group={group} />)}
  </div>
</section>

<style>
  .portfolio-section {
    width: min(calc(100% - 2rem), var(--max-width));
    margin: 0 auto;
    padding: clamp(5rem, 9vw, 8rem) 0;
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--topbar-height) + 24px);
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .portfolio-section {
      width: min(calc(100% - 1.25rem), var(--max-width));
      padding: 4rem 0;
    }
  }
</style>
