---
import ProfilePanel from './ProfilePanel.astro';

const capabilities = [
  {
    index: '01',
    title: 'Design',
    description: 'Product flows, mobile UI/UX, reusable systems and Figma prototypes designed with implementation in mind.',
    stack: 'Figma · UI/UX · Product',
  },
  {
    index: '02',
    title: 'Build',
    description: 'Cross-platform mobile applications with responsive interfaces, real application states and maintainable Flutter architecture.',
    stack: 'Flutter · Dart · Firebase',
  },
  {
    index: '03',
    title: 'Ship',
    description: 'Cloud-backed workflows, AI and REST integrations, subscriptions, localization, security and production store releases.',
    stack: 'Cloud · APIs · IAP · Stores',
  },
];
---

<section class="hero" id="home">
  <div class="pointer-glow" aria-hidden="true"></div>

  <div class="hero-grid">
    <ProfilePanel />

    <div class="work-column">
      <header class="work-intro">
        <div>
          <p class="kicker">MOBILE ENGINEERING + PRODUCT DESIGN</p>
          <h2>From Figma to the App Store.</h2>
        </div>
        <p>
          I work across the parts that turn a mobile idea into a real product — interface design,
          application development, cloud integrations and the final release workflow.
        </p>
      </header>

      <div class="capability-grid">
        {capabilities.map((capability) => (
          <article class="capability-card">
            <div class="capability-top">
              <span>{capability.index}</span>
              <span aria-hidden="true">↘</span>
            </div>
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
            <small>{capability.stack}</small>
          </article>
        ))}
      </div>

      <a class="projects-gateway" href="#projects">
        <span>
          <small>SELECTED WORK</small>
          <strong>See the products behind the stack.</strong>
        </span>
        <span class="gateway-arrow" aria-hidden="true">↓</span>
      </a>
    </div>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Continue to about section">
    <span>SCROLL</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>

<script>
  const hero = document.querySelector('.hero');
  const glow = document.querySelector('.pointer-glow');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero instanceof HTMLElement && glow instanceof HTMLElement && !reduceMotion) {
    let currentX = window.innerWidth * 0.62;
    let currentY = window.innerHeight * 0.38;
    let targetX = currentX;
    let targetY = currentY;
    let frame = 0;

    const render = () => {
      currentX += (targetX - currentX) * 0.14;
      currentY += (targetY - currentY) * 0.14;

      const bounds = hero.getBoundingClientRect();
      glow.style.transform = `translate3d(${currentX - bounds.left - 180}px, ${currentY - bounds.top - 180}px, 0)`;

      if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
        frame = requestAnimationFrame(render);
      } else {
        frame = 0;
      }
    };

    hero.addEventListener('pointermove', (event) => {
      targetX = event.clientX;
      targetY = event.clientY;

      if (!frame) frame = requestAnimationFrame(render);
    }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    padding: calc(var(--topbar-height) + 2rem) clamp(1rem, 3vw, 2.5rem) 2rem;
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: 0.2;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .pointer-glow {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -2;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
    background: radial-gradient(circle, rgba(143, 124, 255, 0.13) 0%, rgba(143, 124, 255, 0.05) 35%, transparent 70%);
    transform: translate3d(55vw, 25vh, 0);
  }

  .hero-grid {
    width: min(100%, var(--max-width));
    min-height: calc(100svh - var(--topbar-height) - 4rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(250px, 0.34fr) minmax(0, 0.66fr);
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .work-column {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .work-intro {
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(240px, 1.05fr);
    gap: 2rem;
    align-items: end;
    padding: clamp(1.2rem, 2.3vw, 1.8rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: rgba(17, 17, 17, 0.82);
  }

  .kicker {
    margin: 0 0 0.55rem;
    color: var(--accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .work-intro h2 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(1.8rem, 3.7vw, 4rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .work-intro > p {
    margin: 0;
    max-width: 38rem;
    justify-self: end;
    color: var(--text-muted);
    font-size: clamp(0.8rem, 1.05vw, 0.94rem);
    line-height: 1.65;
  }

  .capability-grid {
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .capability-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02), transparent 45%),
      var(--surface);
    transition: transform 220ms var(--ease-out), border-color 180ms ease, background 180ms ease;
  }

  .capability-card:hover {
    transform: translateY(-4px);
    border-color: rgba(143, 124, 255, 0.48);
    background: var(--surface-soft);
  }

  .capability-top {
    display: flex;
    justify-content: space-between;
    color: var(--accent);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
  }

  .capability-card h3 {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 3.8rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .capability-card p {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    line-height: 1.6;
  }

  .capability-card small {
    color: rgba(244, 242, 237, 0.58);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .projects-gateway {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: rgba(17, 17, 17, 0.76);
    transition: border-color 180ms ease, background 180ms ease;
  }

  .projects-gateway:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .projects-gateway > span:first-child {
    display: grid;
    gap: 0.2rem;
  }

  .projects-gateway small {
    color: var(--accent);
    font-size: 0.58rem;
    font-weight: 750;
    letter-spacing: 0.14em;
  }

  .projects-gateway strong {
    font-size: clamp(0.9rem, 1.3vw, 1.05rem);
  }

  .gateway-arrow {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    color: var(--accent);
    transition: transform 220ms var(--ease-out), border-color 180ms ease;
  }

  .projects-gateway:hover .gateway-arrow {
    transform: translateY(3px);
    border-color: var(--accent);
  }

  .scroll-cue {
    position: absolute;
    right: max(1rem, calc((100% - var(--max-width)) / 2));
    bottom: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
  }

  .scroll-cue:hover {
    color: var(--text);
  }

  @media (max-width: 1040px) {
    .capability-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(180px, auto);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--topbar-height) + 1.5rem);
    }

    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .work-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .work-intro > p {
      justify-self: start;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-inline: 0.65rem;
      padding-bottom: 0.65rem;
    }

    .pointer-glow {
      display: none;
    }
  }
</style>
