---
import ProfilePanel from './ProfilePanel.astro';
import FeaturedProjectCard from './FeaturedProjectCard.astro';
import { featuredProjects } from '../data/projects';
---

<section class="hero" id="home">
  <div class="pointer-glow" aria-hidden="true"></div>

  <div class="hero-grid">
    <ProfilePanel />

    <div class="work-column">
      <header class="work-intro">
        <div>
          <p class="kicker">AT A GLANCE</p>
          <h2>Shipped + building.</h2>
        </div>
        <p>
          A quick index of the products that best represent my work. Screenshots,
          implementation notes and full project context live in the Projects section below.
        </p>
      </header>

      <div class="featured-projects">
        {featuredProjects.map((project, index) => (
          <FeaturedProjectCard project={project} index={index} />
        ))}
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Continue to about section">
    <span>SCROLL</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>

<script>
  const hero = document.querySelector('.hero');
  const glow = document.querySelector('.pointer-glow');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero instanceof HTMLElement && glow instanceof HTMLElement && !reduceMotion) {
    let currentX = window.innerWidth * 0.62;
    let currentY = window.innerHeight * 0.38;
    let targetX = currentX;
    let targetY = currentY;
    let frame = 0;

    const render = () => {
      currentX += (targetX - currentX) * 0.14;
      currentY += (targetY - currentY) * 0.14;

      const bounds = hero.getBoundingClientRect();
      glow.style.transform = `translate3d(${currentX - bounds.left - 180}px, ${currentY - bounds.top - 180}px, 0)`;

      if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
        frame = requestAnimationFrame(render);
      } else {
        frame = 0;
      }
    };

    hero.addEventListener('pointermove', (event) => {
      targetX = event.clientX;
      targetY = event.clientY;

      if (!frame) frame = requestAnimationFrame(render);
    }, { passive: true });
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    padding: calc(var(--topbar-height) + 2rem) clamp(1rem, 3vw, 2.5rem) 2rem;
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: 0.2;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .pointer-glow {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -2;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
    background: radial-gradient(circle, rgba(143, 124, 255, 0.13) 0%, rgba(143, 124, 255, 0.05) 35%, transparent 70%);
    transform: translate3d(55vw, 25vh, 0);
  }

  .hero-grid {
    width: min(100%, var(--max-width));
    min-height: calc(100svh - var(--topbar-height) - 4rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(250px, 0.34fr) minmax(0, 0.66fr);
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .work-column {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .work-intro {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(220px, 1.2fr);
    gap: 1.5rem;
    align-items: end;
    padding: clamp(1.1rem, 2vw, 1.5rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background: rgba(17, 17, 17, 0.82);
  }

  .kicker {
    margin: 0 0 0.4rem;
    color: var(--accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .work-intro h2 {
    margin: 0;
    font-size: clamp(1.45rem, 2.8vw, 2.8rem);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }

  .work-intro > p {
    margin: 0;
    max-width: 39rem;
    justify-self: end;
    color: var(--text-muted);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    line-height: 1.6;
  }

  .featured-projects {
    min-height: 0;
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .scroll-cue {
    position: absolute;
    right: max(1rem, calc((100% - var(--max-width)) / 2));
    bottom: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
  }

  .scroll-cue:hover {
    color: var(--text);
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--topbar-height) + 1.5rem);
    }

    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .work-intro {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .work-intro > p {
      justify-self: start;
    }

    .featured-projects {
      grid-template-rows: none;
      grid-auto-rows: minmax(270px, auto);
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-inline: 0.65rem;
      padding-bottom: 0.65rem;
    }

    .pointer-glow {
      display: none;
    }
  }
</style>
