---
import ProfilePanel from './ProfilePanel.astro';

const capabilities = [
  {
    title: 'Design',
    description: 'Product flows, mobile UI/UX, reusable systems and Figma prototypes designed with implementation in mind.',
    stack: 'Figma · UI/UX · Product',
    project: 'focial',
    tone: 'red',
  },
  {
    title: 'Build',
    description: 'Cross-platform mobile applications with responsive interfaces, real application states and maintainable Flutter architecture.',
    stack: 'Flutter · Dart · Firebase',
    project: 'evender',
    tone: 'green',
  },
  {
    title: 'Ship',
    description: 'Cloud-backed workflows, AI and REST integrations, subscriptions, localization, security and production store releases.',
    stack: 'Cloud · APIs · IAP · Stores',
    project: 'talevd',
    tone: 'blue',
  },
];
---

<section class="hero" id="home">
  <div class="pointer-glow" aria-hidden="true"></div>

  <div class="hero-grid">
    <ProfilePanel />

    <div class="work-column">
      <header class="work-intro">
        <div>
          <p class="kicker">FLUTTER · PRODUCT DESIGN · RELEASE</p>
          <h2>Mobile products, end to end.</h2>
        </div>
        <p>
          I design the interface, build the application, connect the product systems and carry the final experience through release.
        </p>
      </header>

      <div class="capability-grid">
        {capabilities.map((capability) => (
          <a
            class="capability-card"
            href="#projects"
            data-project-target={capability.project}
            data-tone={capability.tone}
            aria-label={`${capability.title} — view related project`}
          >
            <div class="capability-top">
              <span aria-hidden="true">↘</span>
            </div>
            <div>
              <h3>{capability.title}</h3>
              <p>{capability.description}</p>
            </div>
            <small>{capability.stack}</small>
          </a>
        ))}
      </div>
    </div>
  </div>

  <a class="scroll-cue" href="#about" aria-label="Continue to about section">
    <span>SCROLL</span>
    <span aria-hidden="true">↓</span>
  </a>
</section>

<script>
  const hero = document.querySelector('.hero');
  const glow = document.querySelector('.pointer-glow');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (hero instanceof HTMLElement && glow instanceof HTMLElement && !reduceMotion) {
    let currentX = window.innerWidth * 0.62;
    let currentY = window.innerHeight * 0.38;
    let targetX = currentX;
    let targetY = currentY;
    let frame = 0;

    const render = () => {
      currentX += (targetX - currentX) * 0.14;
      currentY += (targetY - currentY) * 0.14;

      const bounds = hero.getBoundingClientRect();
      glow.style.transform = `translate3d(${currentX - bounds.left - 180}px, ${currentY - bounds.top - 180}px, 0)`;

      if (Math.abs(targetX - currentX) > 0.1 || Math.abs(targetY - currentY) > 0.1) {
        frame = requestAnimationFrame(render);
      } else {
        frame = 0;
      }
    };

    hero.addEventListener('pointermove', (event) => {
      targetX = event.clientX;
      targetY = event.clientY;

      if (!frame) frame = requestAnimationFrame(render);
    }, { passive: true });
  }

  const initialiseCapabilityLinks = () => {
    document.querySelectorAll<HTMLAnchorElement>('[data-project-target]').forEach((link) => {
      if (link.dataset.initialised === 'true') return;
      link.dataset.initialised = 'true';

      link.addEventListener('click', (event) => {
        const slug = link.dataset.projectTarget;
        if (!slug) return;

        const target = document.querySelector<HTMLElement>(`.project-card[data-project="${slug}"]`);
        if (!target) return;

        event.preventDefault();
        target.scrollIntoView({
          behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          block: 'start',
        });
      });
    });
  };

  initialiseCapabilityLinks();
  document.addEventListener('astro:page-load', initialiseCapabilityLinks);
</script>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    padding: calc(var(--topbar-height) + 2rem) clamp(1rem, 3vw, 2.5rem) 2rem;
    isolation: isolate;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -3;
    opacity: 0.2;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to bottom, black, transparent 90%);
  }

  .pointer-glow {
    position: absolute;
    top: 0;
    left: 0;
    z-index: -2;
    width: 360px;
    height: 360px;
    border-radius: 50%;
    pointer-events: none;
    will-change: transform;
    background: radial-gradient(circle, rgba(143, 124, 255, 0.13) 0%, rgba(143, 124, 255, 0.05) 35%, transparent 70%);
    transform: translate3d(55vw, 25vh, 0);
  }

  .hero-grid {
    width: min(100%, var(--max-width));
    min-height: calc(100svh - var(--topbar-height) - 4rem);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(250px, 0.34fr) minmax(0, 0.66fr);
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .work-column {
    min-width: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .work-intro {
    --intro-accent: #f29b52;
    --intro-soft: rgba(242, 155, 82, 0.14);
    display: grid;
    grid-template-columns: minmax(260px, 0.95fr) minmax(240px, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: end;
    padding: clamp(1.3rem, 2.6vw, 2rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02), transparent 46%),
      var(--surface);
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
  }

  .work-intro:hover {
    transform: translateY(-4px);
    border-color: var(--intro-accent);
    background:
      radial-gradient(circle at 22% 18%, var(--intro-soft), transparent 58%),
      var(--surface);
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.22);
  }

  .kicker {
    margin: 0 0 0.65rem;
    color: var(--intro-accent);
    font-size: 0.62rem;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .work-intro h2 {
    margin: 0;
    max-width: 12ch;
    font-size: clamp(1.9rem, 3.7vw, 4rem);
    line-height: 0.94;
    letter-spacing: -0.055em;
  }

  .work-intro > p {
    margin: 0;
    max-width: 36rem;
    justify-self: end;
    color: var(--text-muted);
    font-size: clamp(0.82rem, 1.05vw, 0.96rem);
    line-height: 1.7;
  }

  .capability-grid {
    min-height: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  .capability-card {
    --capability-accent: var(--accent);
    --capability-soft: var(--accent-soft);
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.2rem, 2vw, 1.6rem);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-lg);
    color: inherit;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.02), transparent 45%),
      var(--surface);
    cursor: pointer;
    transition:
      transform 220ms var(--ease-out),
      border-color 220ms ease,
      background 260ms ease,
      box-shadow 260ms ease;
  }

  .capability-card[data-tone='red'] {
    --capability-accent: #ff4c45;
    --capability-soft: rgba(255, 76, 69, 0.14);
  }

  .capability-card[data-tone='green'] {
    --capability-accent: #59d7be;
    --capability-soft: rgba(89, 215, 190, 0.14);
  }

  .capability-card[data-tone='blue'] {
    --capability-accent: #6f86ff;
    --capability-soft: rgba(95, 122, 255, 0.16);
  }

  .capability-card:hover,
  .capability-card:focus-visible {
    transform: translateY(-4px);
    border-color: var(--capability-accent);
    background:
      radial-gradient(circle at 28% 18%, var(--capability-soft), transparent 58%),
      var(--surface);
    box-shadow: 0 20px 52px rgba(0, 0, 0, 0.22);
    outline: none;
  }

  .capability-top {
    display: flex;
    justify-content: flex-end;
    color: var(--capability-accent);
    font-size: 0.75rem;
  }

  .capability-card h3 {
    margin: 0;
    font-size: clamp(2rem, 3.4vw, 3.8rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
  }

  .capability-card p {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: clamp(0.78rem, 1vw, 0.9rem);
    line-height: 1.6;
  }

  .capability-card small {
    color: rgba(244, 242, 237, 0.58);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    line-height: 1.5;
  }

  .scroll-cue {
    position: absolute;
    right: max(1rem, calc((100% - var(--max-width)) / 2));
    bottom: 0.7rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--text-muted);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
  }

  .scroll-cue:hover {
    color: var(--text);
  }

  @media (max-width: 1040px) {
    .capability-grid {
      grid-template-columns: 1fr;
      grid-auto-rows: minmax(180px, auto);
    }
  }

  @media (max-width: 900px) {
    .hero {
      min-height: auto;
      padding-top: calc(var(--topbar-height) + 1.5rem);
    }

    .hero-grid {
      min-height: auto;
      grid-template-columns: 1fr;
    }

    .work-intro {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 1.35rem;
    }

    .work-intro > p {
      justify-self: start;
    }

    .scroll-cue {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .hero {
      padding-inline: 0.65rem;
      padding-bottom: 0.65rem;
    }

    .pointer-glow {
      display: none;
    }
  }
</style>
