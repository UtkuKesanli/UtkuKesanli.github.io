---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section class="projects-section" id="projects" aria-label="Projects">
  <div class="projects-inner">
    <SectionHeading
      index="03"
      title="Products I’ve designed and built."
      description="A mix of released work, collaborative product development and what I’m currently building."
    />

    <div class="projects-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>

    <div class="future-card" aria-label="Future projects">
      <span class="future-mark">+</span>
      <div>
        <p>MORE TO COME</p>
        <h3>And many more future projects.</h3>
        <span>This portfolio is built to grow alongside the things I build next.</span>
      </div>
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 5vw, 5rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--topbar-height) + 24px);
  }

  .projects-inner {
    width: min(100%, var(--max-width));
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .future-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    margin-top: 1rem;
    padding: 1.4rem 1.6rem;
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius-lg);
    background: rgba(255,255,255,0.012);
  }

  .future-mark {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 1.5rem;
  }

  .future-card p {
    margin: 0 0 0.3rem;
    color: var(--accent);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
  }

  .future-card h3 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.2rem, 2vw, 1.65rem);
    letter-spacing: -0.03em;
  }

  .future-card div > span {
    color: var(--text-muted);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .projects-section {
      padding-inline: 1rem;
    }

    .future-card {
      align-items: flex-start;
    }
  }
</style>
