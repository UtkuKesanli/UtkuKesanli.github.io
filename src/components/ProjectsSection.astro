---
import SectionHeading from './SectionHeading.astro';
import ProjectCard from './ProjectCard.astro';
import { projects } from '../data/projects';
---

<section class="projects-section" id="projects" aria-label="Projects">
  <div class="projects-inner">
    <SectionHeading
      title="Products I’ve designed and built."
      description="A mix of released work, collaborative product development and what I’m currently building."
    />

    <div class="projects-grid">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>

<style>
  .projects-section {
    position: relative;
    padding: clamp(5rem, 9vw, 9rem) clamp(1.25rem, 5vw, 5rem);
    border-top: 1px solid var(--line);
    scroll-margin-top: calc(var(--topbar-height) + 24px);
  }

  .projects-inner {
    width: min(100%, var(--max-width));
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    gap: 1rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  @media (max-width: 640px) {
    .projects-section {
      padding-inline: 1rem;
    }
  }
</style>
