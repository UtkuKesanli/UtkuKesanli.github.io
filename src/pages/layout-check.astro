<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="robots" content="noindex,nofollow"/><title>Portfolio viewport check</title></head><body>
<label>Viewport <select id="width"><option>320</option><option>375</option><option>768</option><option>1440</option></select> px</label>
<label>Section <select id="section"><option value="home">Home</option><option value="projects">Projects</option><option value="skills">Skills</option><option value="contact">Contact</option></select></label>
<iframe title="Portfolio viewport" src="/?v=da67e83" style="display:block;width:320px;height:900px;border:0;margin-top:12px"></iframe>
<script>
const frame = document.querySelector('iframe')!;
document.querySelector<HTMLSelectElement>('#width')!.addEventListener('change', event => { frame.style.width = (event.target as HTMLSelectElement).value + 'px'; });
document.querySelector<HTMLSelectElement>('#section')!.addEventListener('change', event => { frame.src = '/?v=da67e83#' + (event.target as HTMLSelectElement).value; });
</script>
<style is:global>body{margin:16px;background:#ddd;color:#111;font-family:system-ui}select{font:inherit;padding:8px}label{margin-right:20px}</style>
</body></html>

