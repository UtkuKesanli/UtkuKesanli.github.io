---
import Hero from '../components/Hero.astro';
import TopLinks from '../components/TopLinks.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import ContactSection from '../components/ContactSection.astro';
import '../styles/global.css';

const siteUrl = 'https://utkukesanli.github.io/';
const title = 'Utku Keşanlı — Flutter Developer & Mobile Product Designer';
const description = 'Utku Keşanlı designs, builds and ships mobile products. Explore TaleVD, Focial and Evender, plus Flutter, Firebase and UI/UX work.';
const preview = new URL('/social-preview.png', siteUrl).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${siteUrl}#person`,
      name: 'Utku Keşanlı',
      url: siteUrl,
      jobTitle: 'Flutter Developer & Mobile Product Designer',
      sameAs: ['https://github.com/UtkuKesanli', 'https://www.linkedin.com/in/utkukesanli'],
    },
    {
      '@type': 'SoftwareApplication',
      name: 'TaleVD',
      applicationCategory: 'EntertainmentApplication',
      operatingSystem: 'iOS',
      url: 'https://apps.apple.com/tr/app/talevd/id6788747924',
      creator: { '@id': `${siteUrl}#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Utku Keşanlı" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={preview} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Utku Keşanlı — Flutter Developer and Mobile Product Designer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={preview} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <TopLinks />
      <main id="main-content" tabindex="-1">
        <Hero />
        <AboutSection />
        <ProjectsSection />
        <ExperienceSection />
        <SkillsSection />
        <ContactSection />
      </main>
    </div>
  </body>
</html>
