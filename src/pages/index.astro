---
import Hero from '../components/Hero.astro';
import TopLinks from '../components/TopLinks.astro';
import AboutSection from '../components/AboutSection.astro';
import ProjectsSection from '../components/ProjectsSection.astro';
import ExperienceSection from '../components/ExperienceSection.astro';
import SkillsSection from '../components/SkillsSection.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Portfolio of Utku Keşanlı — Flutter developer and mobile product builder."
    />
    <title>Utku Keşanlı — Flutter Developer</title>
  </head>
  <body>
    <div class="site-shell">
      <TopLinks />
      <main>
        <Hero />
        <AboutSection />
        <ProjectsSection />
        <ExperienceSection />
        <SkillsSection />
        <section class="section-placeholder" id="contact" aria-label="Contact"></section>
      </main>
    </div>
  </body>
</html>
